# Copy to .env (git-ignored) and fill in.
HAI_API_KEY=
# Optional: header token the demo shop requires when set (poc/demo_site/server.py)
DEMO_TOKEN=
# Optional: Chrome / chromedriver used by the audit runner (defaults to Selenium Manager's Chrome for Testing cache)
# AUDIT_CHROME=/path/to/chrome
# AUDIT_CHROMEDRIVER_DIR=/path/to/dir/containing/chromedriver
# Optional: ignore an outdated chromedriver on your system PATH
# SE_SKIP_DRIVER_IN_PATH=true
# Optional: stable Fernet encryption key for the local credential vault.
# When omitted, an owner-only key is generated at data/vault.key. Keep the original key for existing entries.
# HUMBLE_VAULT_KEY=
# Optional: Devin writes the fixes (service user token cog_..., organisation id org-...; mode: fast|normal|ultra)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MODE=fast
# Optional: Linkup research (journey suggestions, declared accessibility)
LINKUP_API_KEY=
